# Copy this to backend/.env and adjust as needed.
# Database: leave DATABASE_URL unset to use backend/railvigil.db (SQLite).
# For PostgreSQL + PostGIS run backend/scripts/setup_postgres.ps1, which writes
# both URLs below into .env with a generated password (docs/SETUP_POSTGRES.md).
# DATABASE_URL=postgresql+psycopg2://railvigil:<password>@localhost:5432/railvigil
# TEST_DATABASE_URL=postgresql+psycopg2://railvigil:<password>@localhost:5432/railvigil_test
UPLOAD_DIR=./uploads
DATA_DIR=./data
MODELS_DIR=./models
OUTPUTS_DIR=./outputs

MODEL_WEIGHTS=./models/yolov8n.pt
CONF_THRESHOLD=0.35
FRAME_SAMPLE_INTERVAL=3

# Seconds an object must stay in the zone before it counts as an incident
CONFIRM_DWELL_SEC=0.6
# Seconds an object may go unseen before its incident is closed
MISS_GRACE_SEC=1.0
PERSISTENT_DWELL_THRESHOLD_SEC=8.0

# score = 100 * (w_pen * penetration + w_dwell * dwell_norm) * class_factor
RISK_WEIGHT_PENETRATION=0.6
RISK_WEIGHT_DWELL=0.4
RISK_DWELL_NORM_SEC=15.0

# --- logging ---
LOG_LEVEL=INFO

# --- upload validation ---
MAX_UPLOAD_MB=500
MAX_VIDEO_SEC=600
MAX_ZONE_POINTS=50

# --- background processing ---
# Videos processed at once. Each worker loads its own copy of the model.
WORKER_COUNT=1
# Refuse uploads (HTTP 429) while this many videos are waiting/processing
MAX_QUEUED_JOBS=20
# Give up on a video after it has started processing this many times
MAX_JOB_ATTEMPTS=3
# Write progress to the DB at most this often (seconds)
PROGRESS_UPDATE_SEC=2.0
