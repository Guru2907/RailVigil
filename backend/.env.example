# Copy this to backend/.env and adjust as needed
DATABASE_URL=sqlite:///./railvigil.db
UPLOAD_DIR=./uploads
DATA_DIR=./data
MODELS_DIR=./models
OUTPUTS_DIR=./outputs

MODEL_WEIGHTS=./models/yolov8n.pt
CONF_THRESHOLD=0.35
FRAME_SAMPLE_INTERVAL=3

CONSECUTIVE_FRAMES_THRESHOLD=5
PERSISTENT_DWELL_THRESHOLD_SEC=8.0

RISK_WEIGHT_PENETRATION=0.45
RISK_WEIGHT_DWELL=0.30
RISK_WEIGHT_CLASS=0.25
RISK_DWELL_NORM_SEC=15.0